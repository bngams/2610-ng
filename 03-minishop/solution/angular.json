{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "fo": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/fo",
      "sourceRoot": "apps/fo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "cacheExternalArtifacts": true,
            "tsConfig": "apps/fo/tsconfig.federation.json"
          },
          "configurations": {
            "production": {
              "target": "fo:esbuild:production"
            },
            "development": {
              "target": "fo:esbuild:development",
              "dev": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "fo:serve-original:development",
            "tsConfig": "apps/fo/tsconfig.federation.json",
            "rebuildDelay": 500,
            "cacheExternalArtifacts": true,
            "dev": true,
            "devServer": true,
            "port": 0
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/fo/src/main.ts",
            "tsConfig": "apps/fo/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/fo/public"
              }
            ],
            "styles": ["apps/fo/src/material-theme.scss", "apps/fo/src/styles.css"],
            "polyfills": ["es-module-shims"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "fo:esbuild:production"
            },
            "development": {
              "buildTarget": "fo:esbuild:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4200,
            "proxyConfig": "proxy.conf.json"
          }
        }
      }
    },
